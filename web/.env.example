# SafeWatch Admin - cấu hình. Sao chép file này thành ".env" rồi chỉnh sửa.
# Biến môi trường của hệ thống (nếu có) sẽ được ưu tiên hơn file này.

# ---- Máy chủ ----
HOST=0.0.0.0
PORT=5248
# Thư mục chứa các file JSON (tương đối so với thư mục dự án, hoặc đường dẫn tuyệt đối)
DATA_DIR=data
# Chuyển sang Supabase sau khi chạy scripts/supabase_schema.sql.
STORAGE_BACKEND=postgres
SUPABASE_URL=https://dbqehwxeblbchewnjcvb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://dbqehwxeblbchewnjcvb.supabase.co/auth/v1/.well-known/jwks.json
# Đặt true khi chạy sau HTTPS (cookie đăng nhập chỉ gửi qua HTTPS)
REQUIRE_HTTPS=false
# Bật /docs (Swagger UI) để thử API khi phát triển
ENABLE_DOCS=false
# Khóa ký cookie phiên. Để trống = tự sinh và lưu trong data/.secret_key
SECRET_KEY=

# ---- Tài khoản quản trị ----
# Mặc định: admin / ChangeMe!123  ->  HÃY ĐỔI trước khi dùng thật:
#   python scripts/generate_password_hash.py "MatKhauMoiToiThieu12KyTu"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2-sha256$210000$iCO9kG6PevPewoer/8GNKw==$5tJ8EZkrRlDWbO9gKZK8UJH2wYeo8xC5I1Qq3q0TQrs=
ADMIN_STAFF_ID=STAFF-001
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- Quy tắc giám sát ----
MIN_HEART_RATE=50
MAX_HEART_RATE=100
HEART_RATE_SAMPLES_REQUIRED=3
HEART_RATE_WINDOW_MINUTES=5
TELEMETRY_MAX_PAST_HOURS=24
OFFLINE_AFTER_SECONDS=180
OFFLINE_CHECK_INTERVAL_SECONDS=30

# ---- ESP32: POST /alert ----
ESP32_DEFAULT_DEVICE_ID=SW-ESP32-TEST-001
ESP32_REQUIRE_AUTH=false
ESP32_MIN_FALL_CONFIDENCE=0.5
# Số request /alert tối đa mỗi phút cho mỗi địa chỉ IP
ESP32_RATE_LIMIT_PER_MINUTE=60

# ---- Bảo mật telemetry thiết bị (POST /api/telemetry, và /alert nếu ESP32_REQUIRE_AUTH=true) ----
# Bật thì thiết bị phải gửi header X-Device-Key, X-Device-Timestamp (unix giây), X-Device-Nonce.
TELEMETRY_SECURITY_ENABLED=false
TELEMETRY_SHARED_KEY=
# Khóa riêng từng thiết bị: SW-0001=khoa1,SW-0002=khoa2  (hoặc JSON {"SW-0001":"khoa1"})
TELEMETRY_DEVICE_KEYS=
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300

# ---- Telegram ----
# Tạo bot qua @BotFather, lấy chat id bằng cách nhắn cho bot rồi mở trang Cài đặt.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

